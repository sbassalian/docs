    "primary": "#0646CC",
    "light": "#7C9DFF",
    "dark": "#1E5AE0"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#080808"
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
